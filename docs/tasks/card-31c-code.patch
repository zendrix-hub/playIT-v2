diff --git a/app/src/test/java/com/playit/app/presentation/LessonPromptsTest.kt b/app/src/test/java/com/playit/app/presentation/LessonPromptsTest.kt
new file mode 100644
index 0000000..b39b9c9
--- /dev/null
+++ b/app/src/test/java/com/playit/app/presentation/LessonPromptsTest.kt
@@ -0,0 +1,29 @@
+package com.playit.app.presentation
+
+import com.playit.app.presentation.findit.FIND_IT_PROMPT
+import com.playit.app.presentation.sayit.SAY_IT_WORD_PROMPT
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/** Lily's Say It and Find It lines fit the bubble and say exactly what her voice says (card 31c). */
+class LessonPromptsTest {
+
+    @Test fun promptsAreShort() {
+        for (prompt in listOf(SAY_IT_WORD_PROMPT, FIND_IT_PROMPT)) {
+            assertTrue("\"$prompt\" is longer than 8 words", prompt.split(" ").size <= 8)
+        }
+    }
+
+    @Test fun promptsMatchTheReleasedVoice() {
+        val manifest = listOf(
+            File("docs/audio-release/2026-10-13-lines/manifest.json"),
+            File("../docs/audio-release/2026-10-13-lines/manifest.json")
+        ).first { it.exists() }.readText()
+        fun textOf(clipId: String) =
+            Regex(""""clipId":\s*"$clipId"[\s\S]*?"text":\s*"([^"]+)"""").find(manifest)!!.groupValues[1]
+        assertEquals(SAY_IT_WORD_PROMPT, textOf("vo_sayit_word_intro_01"))
+        assertEquals(FIND_IT_PROMPT, textOf("vo_findit_intro_01"))
+    }
+}
